# Your lab's private settings. ./lab.sh setup copies this file to .env and fills it in.
# .env is never committed to git. Keep a copy somewhere safe (./lab.sh backup does this):
# the key below signs your Open WebUI logins.

# Which optional parts run, comma separated: ollama, qdrant, portainer.
# Open WebUI always runs. Leave "ollama" out when you use the native Mac app.
COMPOSE_PROFILES=ollama

# Compose files to combine. Setup adds compose.native-ollama.yml (Mac app),
# compose.nvidia.yml or compose.amd.yml (GPU) when they apply.
COMPOSE_FILE=docker-compose.yml
COMPOSE_PATH_SEPARATOR=:

# Generated once by setup. Never change it after the first start.
WEBUI_SECRET_KEY=

# 127.0.0.1 = only this computer can open the lab (safe default).
# 0.0.0.0   = any device on your home network can, including Portainer.
#             Only do this on a network you trust, and never forward these ports
#             to the internet.
LAB_BIND_ADDRESS=127.0.0.1

# How long a model stays loaded in memory after its last use (Docker Ollama only).
OLLAMA_KEEP_ALIVE=30m

# Optional version overrides. Pinned defaults live in docker-compose.yml.
# OLLAMA_VERSION=
# OPEN_WEBUI_VERSION=
# QDRANT_VERSION=
# PORTAINER_VERSION=
